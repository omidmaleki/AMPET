# ============================================================
#  AMPET — .env.example  (ماده ۶.۳: هیچ سکرت واقعی اینجا نیست)
#  کپی:  cp .env.example .env   (ویندوز: copy .env.example .env)
# ============================================================

# ---- API ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Postgres (docker-compose) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ampet_dev
POSTGRES_USER=ampet
POSTGRES_PASSWORD=ampet_dev_password_change_me
DATABASE_URL=postgresql://ampet:ampet_dev_password_change_me@localhost:5432/ampet_dev

# ---- Redis (docker-compose) ----
REDIS_URL=redis://localhost:6379
# بدون REDIS_URL گارد نرخ‌گیر به‌طور خودکار به حافظه داخلی (in-memory) برمی‌گردد.

# ---- MinIO (docker-compose) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ampet_minio
MINIO_SECRET_KEY=ampet_minio_secret_change_me
MINIO_BUCKET=ampet-assets
MINIO_PUBLIC_URL=http://localhost:9000

# ---- JWT (فقط برای تست محلی؛ در prod از secret مدیریت‌شده استفاده کنید) ----
JWT_ACCESS_SECRET=change_me_access_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_32chars_min
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# ---- SMS ----
# mock = لاگ در فایل logs/sms-mock.log | kavenegar = ارسال واقعی (SP-11)
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ---- Payment ----
# mock = درگاه آزمایشی داخلی | zarinpal = زرین‌پال Sandbox (SP-07)
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=

# ---- سایر ----
BODY_LIMIT_MB=5
TIMEZONE=Asia/Tehran